# Runtime config for src/ and dbt. Not Airflow (see .env.airflow.example).
# Copy to .env (gitignored). One .env points at one stack: GCP_PROJECT_ID,
# GCS_BUCKET_NAME and ENVIRONMENT must name the same environment.
# Terraform reads envs/*.tfvars, not this file.
# To point the laptop at the empty sandbox, follow docs/OPERATIONS.md,
# section "`dev` vs `prod` when running data": change the three values, run
# run-raw-load or run-all, then restore prod.

GCP_PROJECT_ID=your-prod-project-id
GCP_LOCATION=EU
GCS_BUCKET_NAME=your-unique-prod-lake-bucket
BIGQUERY_RAW_DATASET=raw
ENVIRONMENT=prod

# BIGQUERY_RAW_DATASET stays `raw` in dev and prod. Dataset ids are not prefixed.
# Default RAW_SOURCE is local (data/sources). Uncomment the line below only
# to test the Cloud Run path from the laptop, after seed-landing.
# RAW_SOURCE=gcs
