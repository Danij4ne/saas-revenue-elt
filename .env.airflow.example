# Local Airflow only. Copy to .env.airflow (gitignored).
# Do not put GCP keys or the project .env here. Those stay in .env and the
# DAG bind-mounts that file into the app container.
#
# Fernet (32 url-safe base64 bytes):
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# JWT:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If you already ran compose with another Fernet: docker compose down -v
# (does not touch BigQuery or GCS).

AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
HOST_PROJECT_DIR=
HOST_GCP_ADC=

# HOST_PROJECT_DIR and HOST_GCP_ADC are absolute paths, forward slashes.
#   macOS:
#     HOST_PROJECT_DIR=/Users/you/Desktop/saas-revenue-elt
#     HOST_GCP_ADC=/Users/you/.config/gcloud/application_default_credentials.json
#   Windows:
#     HOST_PROJECT_DIR=C:/Users/you/Desktop/saas-revenue-elt
#     HOST_GCP_ADC=C:/Users/you/AppData/Roaming/gcloud/application_default_credentials.json
#   On Windows, backslashes break dotenv (`\U` escapes).
# Restart compose after filling these (`docker compose up -d`).
# The dbt profile is baked into the app image (DECISIONS #16). Do not mount ~/.dbt.
# Unpausing or triggering the DAG hits real GCS and BigQuery.
