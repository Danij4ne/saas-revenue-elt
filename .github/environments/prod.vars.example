# GitHub Environment `prod` variables for deploy.yml.
# These are identifiers: create them as vars.*, not secrets.*.
# Fill them after the local apply of terraform/identity on the prod backend.
# deploy.yml never applies terraform/identity. On the runner it writes these
# values into terraform/backend-prod.hcl and terraform/envs/prod.tfvars.
# github_repository and app_image_tag come from the GitHub context, not from
# Environment vars.

GCP_PROJECT_ID=
GCP_LAKE_BUCKET=
TFSTATE_BUCKET=
GCP_REGION=
GCP_LOCATION=
GCP_WIF_PROVIDER=
GCP_DEPLOY_SA=
GCP_ALERT_EMAIL=

# GCP_PROJECT_ID: data-bearing project. Same as prod.tfvars gcp_project_id.
# GCP_LAKE_BUCKET: data lake, not the tfstate bucket. Same as bucket_name.
# TFSTATE_BUCKET: same as tfstate_bucket_name and backend-prod.hcl bucket.
# GCP_REGION / GCP_LOCATION: same as gcp_region / gcp_location.
# GCP_WIF_PROVIDER: terraform output -raw github_wif_provider_name (prod backend).
#   projects/<NUMBER>/locations/global/workloadIdentityPools/github-actions/providers/github
# GCP_DEPLOY_SA: terraform output -raw github_deploy_service_account_email
#   (prod backend). github-deploy@<prod-project>.iam.gserviceaccount.com.
#   Not elt-pipeline. Not the dev SA.
# GCP_ALERT_EMAIL: Job-failed notification (var.alert_email). Not a secret.
# GCP_PROD_DEPLOY_SA lives on Environment `dev` (this SA's email), not here.
